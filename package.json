{
  "name": "tren",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "pnpm build:shared && pnpm --filter @tren/api prisma:generate",
    "build:shared": "pnpm --filter @tren/shared build",
    "dev": "pnpm build:shared && pnpm -r --parallel --filter=./apps/* dev",
    "dev:api": "pnpm build:shared && pnpm --filter @tren/api start:dev",
    "dev:web": "pnpm build:shared && pnpm --filter @tren/web dev",
    "build": "pnpm build:shared && pnpm --filter @tren/api build && pnpm --filter @tren/web build",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "test": "pnpm --filter @tren/api test",
    "db:migrate": "pnpm --filter @tren/api prisma:migrate",
    "db:seed": "pnpm --filter @tren/api prisma:seed",
    "db:studio": "pnpm --filter @tren/api prisma:studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  }
}
