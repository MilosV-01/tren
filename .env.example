# ---------------------------------------------------------------------------
# Tren — environment configuration
# Copy this file to `.env` at the repo root. Both apps read from it:
#   - apps/api  loads it directly (dotenv via @nestjs/config)
#   - apps/web  reads it through next.config.mjs (see that file)
# ---------------------------------------------------------------------------

# === Runtime =================================================================
NODE_ENV=development

# === API (NestJS) ===========================================================
API_PORT=4000
# Origin(s) of the web app, used for CORS. One origin, a comma-separated list
# (e.g. http://localhost:3000,http://192.168.1.20:3000), or "*" to reflect any
# origin (dev only). Browser traffic normally goes through the web app's
# same-origin proxies, so this is a safety net.
WEB_ORIGIN=http://localhost:3000

# === Database (PostgreSQL / Prisma) =========================================
# Matches docker-compose.yml credentials.
DATABASE_URL=postgresql://tren:tren@localhost:5432/tren?schema=public

# === Auth ===================================================================
# Secret for signing organizer JWTs. Generate a long random string for real envs.
JWT_SECRET=dev-only-change-me-please-32-chars-min
# Access token lifetime.
JWT_EXPIRES_IN=7d

# === Object storage ========================================================
# STORAGE_DRIVER = "disk" (files on a local/mounted path, served through the
# API's /api/blob routes — no S3 account) or "s3" (any S3-compatible endpoint,
# direct browser upload).
STORAGE_DRIVER=disk
STORAGE_DISK_PATH=./.storage
# API's own externally-reachable URL (disk driver builds /api/blob links from it).
# Leave empty locally; on Render it auto-uses RENDER_EXTERNAL_URL.
API_PUBLIC_URL=

# --- only when STORAGE_DRIVER=s3 (AWS S3 / Cloudflare R2 / MinIO) ---
# AWS S3:   leave S3_ENDPOINT empty, set S3_REGION + keys, S3_FORCE_PATH_STYLE=false
# Cloudflare R2: S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com, S3_REGION=auto
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=tren-media
# MinIO and R2 need path-style addressing; real AWS S3 does not.
S3_FORCE_PATH_STYLE=true
# Public base URL browsers use to reach the bucket. For MinIO this is the API port.
# Leave empty to reuse S3_ENDPOINT.
S3_PUBLIC_URL=http://localhost:9000

# Presigned URL lifetimes (seconds).
UPLOAD_URL_TTL=900
DOWNLOAD_URL_TTL=3600

# === Uploads ================================================================
# Max single file size accepted (bytes). Default 200 MB (videos).
MAX_UPLOAD_BYTES=209715200

# === Retention =============================================================
RETENTION_FREE_DAYS=7
RETENTION_PREMIUM_DAYS=90
# When true, CleanupService's cron is registered (kept off for Phase 1).
CLEANUP_CRON_ENABLED=false

# === Web (Next.js) =========================================================
# Server-side only: how the Next server reaches the API.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Runtime base URL of the web app. For phone testing on a LAN, set this to
# http://<your-lan-ip>:3000 so scanned QR links resolve on the phone.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Canonical public URL for SEO only (metadata, sitemap, Open Graph).
# Set to the real domain in production.
NEXT_PUBLIC_SITE_URL=https://tren.rs
